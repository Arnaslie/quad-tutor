# Copy to .env.local and fill in.

# Postgres. Local for dev; Neon in deployed environments (branch-per-PR).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutor_finder"
# Production migrations do not read this file: .github/workflows/migrate.yml takes
# DATABASE_URL_UNPOOLED from the GitHub Environment `production` (Neon's direct, non-pooled URL).

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Stripe Connect Express. KYC is deferred to a tutor's first accepted request,
# not signup — see docs/decisions.md. Test keys (sk_test_) only: a live key is
# refused everywhere until refunds and tutor transfers go through Stripe.
STRIPE_SECRET_KEY=""
# Signing secrets (whsec_) for /api/stripe/webhook: the platform endpoint, and the
# Connect endpoint once tutor payouts land. Locally, `stripe listen` prints one
# secret; put it in both.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
# STRIPE_FAKE=1 swaps Stripe for an in-repo fake: checkout opens a local page at
# /api/dev/checkout/<id> that pays or expires the session and posts a webhook
# signed with STRIPE_WEBHOOK_SECRET (any whsec_ string works). Makes no Stripe
# calls, needs no key, and is refused in production. Never set it on Vercel,
# previews included: its state lives on local disk, which serverless loses.
STRIPE_FAKE=""

# The scheduled sweep at /api/cron refuses every request without this, so a
# missing value fails closed rather than exposing the endpoint. Any long random
# string: `openssl rand -base64 32`.
CRON_SECRET=""

# Transactional email (Resend). Without a key, mail is logged to the console in
# development and refused in production — a dropped magic link leaves somebody
# staring at "check your email" with nothing in any log to explain it.
# EMAIL_FROM must be on a domain verified with Resend, or every send is rejected.
RESEND_API_KEY=""
EMAIL_FROM="Quad Tutor <hello@yourdomain.com>"

# db:seed creates its fixture people as plus-aliases of this inbox
# (you+maya-chen@gmail.com), so their mail reaches you and you can sign in as any
# of them. Not needed for db:catalog. It also makes you+ops@ an operator for the
# seeded campus, which opens /ops.
SEED_INBOX=""

# Private Vercel Blob store for transcript proof. On Vercel, connecting a
# *private* Blob store to the project adds BLOB_STORE_ID and authenticates with
# OIDC, so nothing needs pasting. Outside Vercel set BLOB_READ_WRITE_TOKEN from
# the store's settings. With neither set, development keeps files in
# ./.proof-store and production refuses uploads.
BLOB_READ_WRITE_TOKEN=""

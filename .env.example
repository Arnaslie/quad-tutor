# Copy to .env.local and fill in.

# Postgres. Local for dev; Neon in deployed environments (branch-per-PR).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutor_finder"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Stripe Connect Express. KYC is deferred to a tutor's first accepted request,
# not signup — see docs/decisions.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# The scheduled sweep at /api/cron refuses every request without this, so a
# missing value fails closed rather than exposing the endpoint. Any long random
# string: `openssl rand -base64 32`.
CRON_SECRET=""
